<!-- Seção de Filtros por Tag -->
<div class="filter-container" id="tag-filters">
  <button class="filter-btn active" onclick="filtrarPosts('todos')">Todos</button>
</div>

<!-- Grid onde os Cards dos Artigos serão inseridos -->
<div class="posts-grid" id="posts-container">
  <!-- Artigos carregados via JS -->
</div>

<script>
let todosOsPosts = [];

async function carregarPublicacoes() {
  try {
    const response = await fetch('./posts.json');
    todosOsPosts = await response.json();
    
    gerarBotoesDeTags(todosOsPosts);
    renderizarPosts(todosOsPosts);
  } catch (erro) {
    console.error('Erro ao carregar os artigos:', erro);
  }
}

// Extrai as tags únicas do JSON e gera os botões automaticamente
function gerarBotoesDeTags(posts) {
  const filterContainer = document.getElementById('tag-filters');
  const tagsSet = new Set();
  
  posts.forEach(post => {
    if (post.tags) {
      post.tags.forEach(tag => tagsSet.add(tag));
    }
  });

  tagsSet.forEach(tag => {
    const btn = document.createElement('button');
    btn.className = 'filter-btn';
    btn.innerText = tag;
    btn.onclick = () => filtrarPosts(tag, btn);
    filterContainer.appendChild(btn);
  });
}

// Renderiza os cards na tela
function renderizarPosts(posts) {
  const container = document.getElementById('posts-container');
  container.innerHTML = '';

  if (posts.length === 0) {
    container.innerHTML = '<p>Nenhum artigo encontrado para esta tag.</p>';
    return;
  }

  posts.forEach(post => {
    const card = document.createElement('article');
    card.className = 'post-card';
    card.innerHTML = `
      <div class="post-tags">
        ${post.tags.map(t => `<span class="tag-badge">${t}</span>`).join('')}
      </div>
      <h2><a href="${post.url}">${post.titulo}</a></h2>
      <p class="post-excerpt">${post.resumo}</p>
      <a href="${post.url}" class="read-more">Ler publicação →</a>
    `;
    container.appendChild(card);
  });
}

// Filtra os posts ao clicar na tag
function filtrarPosts(tag, elementoClicado) {
  // Atualiza classe ativa dos botões
  const botoes = document.querySelectorAll('.filter-btn');
  botoes.forEach(b => b.classList.remove('active'));
  
  if (elementoClicado) {
    elementoClicado.classList.add('active');
  } else {
    document.querySelector('.filter-btn').classList.add('active');
  }

  if (tag === 'todos') {
    renderizarPosts(todosOsPosts);
  } else {
    const filtrados = todosOsPosts.filter(p => p.tags && p.tags.includes(tag));
    renderizarPosts(filtrados);
  }
}

// Inicia o carregamento ao abrir a página
document.addEventListener('DOMContentLoaded', carregarPublicacoes);
</script>
